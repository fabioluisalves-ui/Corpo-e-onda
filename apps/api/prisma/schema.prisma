// Corpo & Onda Estoque — modelo de dados
// IDs internos: UUID. IDs externos: String (suportam > int32).
// Datas em UTC. Quantidades inteiras. Valores monetários em centavos (Int).

generator client {
  provider      = "prisma-client-js"
  // "native" cobre o ambiente local; o alvo debian/openssl-3 é o do Render (Linux).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductKind {
  SINGLE
  STOCKED_KIT
  VIRTUAL_KIT
}

enum MovementType {
  PRODUCTION_ENTRY
  PURCHASE_ENTRY
  MANUAL_SALE
  NUVEMSHOP_SALE
  CUSTOMER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  KIT_ASSEMBLY
  KIT_DISASSEMBLY
  RESERVATION
  RESERVATION_RELEASE
}

enum Role {
  ADMIN
  MANAGER
  STOCK_OPERATOR
  VIEWER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  users              User[]
  memberships        Membership[]
  stockLocations     StockLocation[]
  products           Product[]
  productVariants    ProductVariant[]
  inventoryMovements InventoryMovement[]
  stockBalances      StockBalance[]
  integrations       Integration[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  email        String   @unique
  passwordHash String // Argon2
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  memberships  Membership[]

  @@index([orgId])
  @@map("users")
}

model Membership {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @db.Uuid
  userId String @db.Uuid
  role   Role

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@map("memberships")
}

model StockLocation {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  code      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@map("stock_locations")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  orgId       String      @db.Uuid
  name        String
  category    String?
  kind        ProductKind @default(SINGLE)
  description String?
  photoUrl    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  variants     ProductVariant[]

  @@index([orgId, name])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  productId     String   @db.Uuid
  sku           String // exibição
  skuNormalized String // UNIQUE case-insensitive
  color         String?
  size          String?
  priceCents    Int?
  gtin          String? // EAN/GTIN oficial (GS1), opcional
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization       @relation(fields: [orgId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  barcodes      Barcode[]
  balances      StockBalance[]
  reservations  StockReservation[]
  movements     InventoryMovement[]
  kitComponents KitComponent[]     @relation("KitParent")
  asComponentOf KitComponent[]     @relation("KitChild")

  @@unique([orgId, skuNormalized])
  @@index([orgId, sku])
  @@index([productId])
  @@map("product_variants")
}

model Barcode {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  variantId String   @db.Uuid
  // Tipo do código: INTERNAL (Code128 do SKU) ou GTIN (EAN oficial)
  kind      String
  value     String
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([orgId, value])
  @@index([value])
  @@map("barcodes")
}

model KitComponent {
  id             String @id @default(uuid()) @db.Uuid
  orgId          String @db.Uuid
  kitVariantId   String @db.Uuid // variante do conjunto (STOCKED_KIT ou VIRTUAL_KIT)
  componentId    String @db.Uuid // variante componente
  quantityPerKit Int

  kitVariant ProductVariant @relation("KitParent", fields: [kitVariantId], references: [id])
  component  ProductVariant @relation("KitChild", fields: [componentId], references: [id])

  @@unique([kitVariantId, componentId])
  @@index([componentId])
  @@map("kit_components")
}

model StockBalance {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  locationId String   @db.Uuid
  variantId  String   @db.Uuid
  onHand     Int      @default(0)
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([orgId, locationId, variantId])
  @@index([variantId])
  @@map("stock_balances")
}

model StockReservation {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  locationId String   @db.Uuid
  variantId  String   @db.Uuid
  quantity   Int
  externalOrderId String?
  status     String   @default("ACTIVE") // ACTIVE, RELEASED, CONVERTED
  createdAt  DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([externalOrderId])
  @@map("stock_reservations")
}

model InventoryMovement {
  id                  String       @id @default(uuid()) @db.Uuid
  orgId               String       @db.Uuid
  locationId          String       @db.Uuid
  variantId           String       @db.Uuid
  type                MovementType
  quantity            Int
  previousOnHand      Int
  newOnHand           Int
  previousReserved    Int          @default(0)
  newReserved         Int          @default(0)
  userId              String?      @db.Uuid
  origin              String
  reason              String?
  externalOrderNumber String?
  idempotencyKey      String?
  reversalOfMovementId String?     @db.Uuid
  groupId             String?      @db.Uuid
  metadata            Json?
  createdAt           DateTime     @default(now())

  organization Organization              @relation(fields: [orgId], references: [id])
  variant      ProductVariant            @relation(fields: [variantId], references: [id])
  items        InventoryMovementItem[]

  @@unique([orgId, idempotencyKey], name: "uq_movement_idempotency")
  @@index([variantId, createdAt])
  @@index([orgId, type, createdAt])
  @@index([externalOrderNumber])
  @@index([groupId])
  @@map("inventory_movements")
}

// Para operações compostas (montagem de kit, pedidos multi-item)
model InventoryMovementItem {
  id         String @id @default(uuid()) @db.Uuid
  movementId String @db.Uuid
  variantId  String @db.Uuid
  quantity   Int
  role       String // COMPONENT | KIT | ITEM
  externalItemId String?

  movement InventoryMovement @relation(fields: [movementId], references: [id])

  @@index([movementId])
  @@map("inventory_movement_items")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model Integration {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  provider      String // 'nuvemshop'
  enabled       Boolean  @default(false)
  // Tokens criptografados (AES-GCM). Nunca enviados ao navegador.
  encryptedTokens String?
  externalStoreId String?
  lastSyncAt    DateTime?
  status        String   @default("DISCONNECTED")
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, provider])
  @@map("integrations")
}

model ExternalVariantMapping {
  id              String @id @default(uuid()) @db.Uuid
  orgId           String @db.Uuid
  provider        String
  variantId       String @db.Uuid // variante interna
  externalProductId String
  externalVariantId String
  externalLocationId String?
  sku             String

  @@unique([orgId, provider, externalVariantId])
  @@index([variantId])
  @@index([sku])
  @@map("external_variant_mappings")
}

model ExternalOrder {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  provider      String
  externalOrderId String
  status        String
  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orgId, provider, externalOrderId])
  @@index([externalOrderId])
  @@map("external_orders")
}

model WebhookInbox {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String?  @db.Uuid
  provider    String
  event       String
  externalId  String? // id do recurso (ex.: order id)
  hmacValid   Boolean  @default(false)
  payload     Json
  processedAt DateTime?
  status      String   @default("RECEIVED") // RECEIVED, PROCESSED, FAILED
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())

  // Idempotência de webhooks: mesmo provider+event+externalId+hash não duplica
  dedupeKey String @unique

  @@index([provider, event])
  @@index([status])
  @@map("webhook_inbox")
}

model OutboxJob {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  type        String // ex.: 'PUBLISH_STOCK'
  payload     Json
  status      String   @default("PENDING") // PENDING, PROCESSING, DONE, FAILED
  attempts    Int      @default(0)
  runAfter    DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAfter])
  @@map("outbox_jobs")
}
