{
  "name": "corpo-onda-estoque",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20 <23" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @corpo-onda/api test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @corpo-onda/api prisma:migrate",
    "db:seed": "pnpm --filter @corpo-onda/api seed"
  }
}
