# ===== Banco de dados =====
DATABASE_URL="postgresql://corpoonda:corpoonda@localhost:5432/corpoonda?schema=public"

# ===== API =====
PORT=3333
CORS_ORIGINS="http://localhost:3000"

# ===== Autenticação (gere segredos fortes; NUNCA versione valores reais) =====
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-acesso"
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ===== Frontend =====
NEXT_PUBLIC_API_URL="http://localhost:3333/api/v1"

# ===== Nuvemshop (DESATIVADO no MVP — não preencher sem autorização) =====
NUVEMSHOP_ENABLED="false"
NUVEMSHOP_CLIENT_ID=""
NUVEMSHOP_CLIENT_SECRET=""
NUVEMSHOP_WEBHOOK_SECRET=""
# Chave de criptografia dos tokens armazenados (AES-256-GCM, 32 bytes em base64)
TOKENS_ENCRYPTION_KEY=""
