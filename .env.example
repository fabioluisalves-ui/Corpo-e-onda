# ===== Banco de dados =====
DATABASE_URL="postgresql://corpoonda:corpoonda@localhost:5432/corpoonda?schema=public"

# ===== API =====
PORT=3333
CORS_ORIGINS="http://localhost:3000"

# ===== Autenticação (gere segredos fortes; NUNCA versione valores reais) =====
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-acesso"
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ===== Frontend =====
NEXT_PUBLIC_API_URL="http://localhost:3333/api/v1"

# ===== Nuvemshop (DESATIVADO por padrão — testar primeiro na loja demo) =====
# Para loja própria, use um "Aplicativo sob medida": gera store_id + token permanente.
NUVEMSHOP_ENABLED="false"
NUVEMSHOP_STORE_ID=""            # id numérico da loja
NUVEMSHOP_ACCESS_TOKEN=""        # token permanente do app sob medida
NUVEMSHOP_CLIENT_SECRET=""       # segredo do app — usado para validar o HMAC dos webhooks
NUVEMSHOP_API_VERSION="2025-03"  # versão da API Nuvemshop
NUVEMSHOP_USER_AGENT="Corpo e Onda Estoque (contato@corpoonda.com.br)"  # obrigatório pela API

# Chave de criptografia (reservada para uso futuro; AES-256, 32 bytes em base64)
TOKENS_ENCRYPTION_KEY=""
